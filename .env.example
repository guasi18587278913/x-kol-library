# ========================================
# 推特大佬电子阅览室 - 环境变量配置
# ========================================
# 复制此文件为 .env 并修改为你自己的值
# cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=xkol
POSTGRES_PASSWORD=xkol_secret_2026
POSTGRES_DB=xkol_db
POSTGRES_PORT=5432

# --- pgAdmin（可选，数据库管理界面）---
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@xkol.local
PGADMIN_PASSWORD=admin123

# --- Next.js 应用数据库连接 ---
DATABASE_URL=postgresql://xkol:xkol_secret_2026@localhost:5432/xkol_db

# --- Anthropic API (翻译服务) ---
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
